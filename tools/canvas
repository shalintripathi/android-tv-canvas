#!/usr/bin/env bash
# Canvas TV tool. Run `tools/canvas help`.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
VENV="$HERE/venv"
if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q --no-cache-dir -r "$HERE/requirements.txt"
fi
exec "$VENV/bin/python" -I "$HERE/canvas.py" "$@"
